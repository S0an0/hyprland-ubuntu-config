#!/usr/bin/env python3
import html
import os
import subprocess
import sys
from pathlib import Path

if len(sys.argv) != 2:
    raise SystemExit(f"usage: {sys.argv[0]} OUTPUT")

template_path = Path.home() / ".config" / "gtklock" / "layout.xml.in"
output_path = Path(sys.argv[1])


def command_text(*arguments):
    try:
        result = subprocess.run(arguments, check=True, capture_output=True, text=True, timeout=3)
        return result.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


weather = command_text(str(Path.home() / ".local" / "bin" / "hypr-weather"), "lock")
forecast = command_text(str(Path.home() / ".local" / "bin" / "hypr-weather"), "forecast")
if not weather:
    weather = "Погода недоступна"

layout = template_path.read_text(encoding="utf-8")
layout = layout.replace("@@WEATHER@@", html.escape(weather))
layout = layout.replace("@@FORECAST@@", html.escape(forecast))

output_path.parent.mkdir(parents=True, exist_ok=True)
temporary = output_path.with_name(f"{output_path.name}.{os.getpid()}.tmp")
temporary.write_text(layout, encoding="utf-8")
os.replace(temporary, output_path)
