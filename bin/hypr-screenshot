#!/usr/bin/env bash
set -euo pipefail

out_dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$out_dir"
out="$out_dir/$(date +%Y-%m-%d_%H-%M-%S).png"

case "${1:-region}" in
  region)
    geometry=$(slurp) || exit 0
    grim -g "$geometry" - | swappy -f -
    ;;
  full)
    grim "$out"
    wl-copy < "$out"
    notify-send "Снимок экрана" "Сохранён: $out"
    ;;
  *) exit 2 ;;
esac

