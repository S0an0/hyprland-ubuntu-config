* {
    bg: #303446f2;
    bg-alt: #414559e6;
    surface: #414559cc;
    surface-hover: #51576dcc;
    fg: #c6d0f5;
    muted: #838ba7;
    accent: #ca9ee6;
    accent-alt: #81c8be;
    selection-fg: #232634;
}
window {
    width: 40%;
    border: 2px;
    border-color: @accent;
    border-radius: 22px;
    background-color: @bg;
    padding: 18px;
}
mainbox { spacing: 14px; background-color: transparent; }
inputbar { children: [prompt, entry]; spacing: 10px; background-color: @surface; border: 1px; border-color: @surface-hover; border-radius: 14px; padding: 13px 16px; }
prompt { background-color: transparent; text-color: @accent; padding: 0 4px 0 0; }
entry { background-color: transparent; text-color: @fg; placeholder: "Поиск…"; placeholder-color: @muted; }
listview { lines: 8; columns: 1; fixed-height: false; spacing: 7px; scrollbar: false; background-color: transparent; }
element { padding: 11px 13px; border: 1px; border-color: transparent; border-radius: 12px; background-color: transparent; }
element normal.normal, element alternate.normal { background-color: transparent; text-color: @fg; }
element selected.normal { background-color: @accent; border-color: @accent; text-color: @selection-fg; }
element-icon { size: 30px; margin: 0 13px 0 0; background-color: transparent; }
element-text { vertical-align: 0.5; background-color: transparent; text-color: inherit; }
message { background-color: transparent; }
textbox { background-color: @surface; text-color: @fg; border-radius: 12px; padding: 10px; }
