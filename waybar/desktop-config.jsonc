{
  "name": "desktop-widgets",
  "layer": "bottom",
  "position": "top",
  "height": 220,
  "exclusive": false,
  "passthrough": true,
  "margin-top": 90,
  "margin-left": 100,
  "margin-right": 100,
  "spacing": 18,
  "modules-center": ["custom/clock", "custom/weather", "custom/calendar"],

  "custom/clock": {
    "interval": 1,
    "exec": "$HOME/.local/bin/hypr-desktop-clock",
    "return-type": "json",
    "tooltip": false
  },

  "custom/weather": {
    "exec": "$HOME/.local/bin/hypr-weather desktop",
    "return-type": "json",
    "interval": 300,
    "tooltip": true
  },

  "custom/calendar": {
    "exec": "$HOME/.local/bin/hypr-calendar",
    "return-type": "json",
    "interval": 1800,
    "tooltip": false
  }
}
